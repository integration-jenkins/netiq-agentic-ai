NETIQ_API_BASE_URL=http://localhost:6061
NETIQ_LOGIN_PATH=/api/login
NETIQ_LOGIN_METHOD=GET

# Optional: if you know the 6061 endpoint that returns the CURRENT logged-in user's JSON, set it here.
# NETIQ_USERINFO_PATH=/api/user

# Optional TESTING fallback: server logs in to 6061 itself (no browser needed). Remove after testing.
# NETIQ_TEST_USERNAME=NETIQ_ADMIN
# NETIQ_TEST_PASSWORD=test123

# Chat login session ends after this many seconds without activity (30 min, same as NETIQ).
SESSION_IDLE_TIMEOUT=1800
