# Add non-secret environment variable names and safe local defaults here.

# Session management (task 1.6)
# Login session ends after this many seconds without activity (30 min, same as NETIQ).
SESSION_IDLE_TIMEOUT=1800
# Chat memory (SQLite). Defaults shown; CHAT_DB_PATH defaults to data/session/chat_history.db.
# CHAT_DB_PATH=
# HISTORY_WINDOW_MESSAGES=10
# CHAT_RETENTION_DAYS=30
# KEYWORD_RETENTION_DAYS=90
# One-line chat summaries use the chat_summarizer model in configs/models.yaml.
# Set this only if that model is not installed on your machine, e.g. llama3.2:3b.
# CHAT_SUMMARY_MODEL=
